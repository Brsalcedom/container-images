{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "semanticCommits": "enabled",
  "docker": {
    "enabled": true,
    "pinDigests": true
  },
  "dockerfile": {
    "enabled": true
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "dependencies"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "ARGs/variables annotated with `# renovate: datasource=... depName=...` in Dockerfiles and workflows",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/",
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n\\s*(?:ARG\\s+|ENV\\s+)?[A-Za-z0-9_]+\\s*[=:]\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Changes inside an image: `fix(...)` commit so release-please cuts a patch release of that image",
      "matchFileNames": ["images/**"],
      "semanticCommitType": "fix"
    },
    {
      "description": "Repository workflows and tooling: no image release",
      "matchFileNames": [".github/**", "scripts/**"],
      "semanticCommitType": "chore"
    },
    {
      "description": "Docker base images - patch/pin/digest (manual review)",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": false,
      "labels": ["dependencies", "docker", "automerge-candidate"],
      "schedule": ["before 6am on monday"]
    },
    {
      "description": "Docker base images - minor updates require review",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor"],
      "automerge": false,
      "labels": ["dependencies", "docker"],
      "schedule": ["before 6am on monday"]
    },
    {
      "description": "Docker base images - major updates require careful review",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "docker", "major-update"],
      "schedule": ["before 6am on monday"]
    },
    {
      "description": "Tools built from source (ARG *_VERSION)",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["images/**"],
      "schedule": ["before 6am on monday"]
    }
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "timezone": "America/Santiago",
  "labels": ["renovate"],
  "assignees": [],
  "reviewers": []
}
